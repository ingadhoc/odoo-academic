<odoo>
    <record id="view_update_payment_responsible_wizard" model="ir.ui.view">
        <field name="name">update.payment.responsible.wizard.form</field>
        <field name="model">update.payment.responsible.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Payment Responsible">
                <group>
                    <field name="invoice_ids" invisible="1"/>
                    <field name="update_type"/>
                </group>
                <field name="line_ids" invisible="update_type != 'manual'">
                    <list editable="bottom">
                        <field name="invoice_id" readonly="1" force_save="1"/>
                        <field name="current_responsible_id"/>
                        <field name="new_responsible_id"/>
                    </list>
                </field>
                <footer>
                    <button string="Update" type="object" name="action_update_responsible" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_payment_responsible" model="ir.actions.act_window">
        <field name="name">Update Payment Responsible</field>
        <field name="res_model">update.payment.responsible.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
