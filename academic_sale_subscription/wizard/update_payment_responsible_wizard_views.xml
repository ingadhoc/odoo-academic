<odoo>
    <record id="view_update_payment_responsible_wizard" model="ir.ui.view">
        <field name="name">update.payment.responsible.wizard.form</field>
        <field name="model">update.payment.responsible.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert" style="margin-bottom: 16px;">
                    <span>Only invoices with a newly selected payment responsible and without registered payments up to now will be modified.</span>
                </div>
                <field name="invoice_ids" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="invoice_ids" readonly="1" force_save="1" widget="many2many_tags" optional="hide"/>
                        <field name="current_responsible_id" readonly="1" force_save="1"/>
                        <field name="new_responsible_id"/>
                    </list>
                </field>
                <footer>
                    <button string="Update" type="object" name="action_update_responsible" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
