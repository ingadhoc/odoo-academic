<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- ======================================================================== -->
        <!-- SUSCRIPCIÓN 1: FAMILIA GARCÍA - SOFÍA (PRIMARIA - 1ER AÑO A)          -->
        <!-- ======================================================================== -->
        <record id="subscription_garcia_sofia" model="sale.order">
            <field name="partner_id" ref="academic.res_partner_sofia_garcia"/>
            <field name="sale_order_template_id" ref="subscription_template_primaria"/>
            <field name="plan_id" ref="subscription_plan_12_cuotas"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">draft</field>
            <field name="client_order_ref">SUB-GARCIA-001</field>
            <field name="company_id" ref="academic.res_company_los_arroyos"/>
        </record>

        <!-- Trigger para llenar automáticamente las líneas desde la plantilla -->
        <function model="sale.order"
                  name="_onchange_sale_order_template_id"
                  eval="[ref('subscription_garcia_sofia')]"/>

        <!-- Computar responsable de pago automáticamente -->
        <function model="sale.order"
                  name="_compute_partner_invoice"
                  eval="[ref('subscription_garcia_sofia')]"/>

        <!-- Agregar group_id a las líneas de suscripción García -->
        <function model="sale.order.line"
                  name="write"
                  eval="[obj().env['sale.order'].browse(ref('subscription_garcia_sofia')).order_line.filtered(lambda l: not l.display_type).ids, {'group_id': obj().env.ref('academic.academic_group_1a_main').id}]"/>

        <!-- Confirmar la suscripción -->
        <function model="sale.order" name="action_confirm" eval="[[ref('subscription_garcia_sofia')]]" context="{'action_no_send_mail': True}"/>

