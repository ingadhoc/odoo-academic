        <!-- Productos Primaria -->
        <record id="product_cuota_primaria" model="product.product">
            <field name="name">Cuota Mensual - Primaria</field>
            <field name="type">service</field>
            <field name="recurring_invoice">True</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="list_price">12000.0</field>
            <field name="standard_price">12000.0</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="invoice_policy">order</field>
            <field name="service_type">manual</field>
            <field name="academic_product_type">fee</field>
            <field name="product_subscription_pricing_ids" eval="[(6,0,[ref('pricing_primaria_1_cuota'), ref('pricing_primaria_3_cuotas'), ref('pricing_primaria_6_cuotas'), ref('pricing_primaria_12_cuotas'), ref('pricing_primaria_anual')])]"/>
        </record>

