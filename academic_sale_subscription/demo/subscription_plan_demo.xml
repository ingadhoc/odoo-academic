<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Subscription Pricing for Academic Products -->
        <!-- In Odoo 19, subscription pricing is handled through product.pricelist.item with plan_id -->
        <!-- Precios para productos de Primaria -->
        <record id="pricing_primaria_1_cuota" model="product.pricelist.item">
            <field name="plan_id" ref="subscription_plan_1_cuota"/>
            <field name="pricelist_id" eval="False"/>
            <field name="product_tmpl_id" ref="product_cuota_primaria"/>
            <field name="compute_price">fixed</field>
            <field name="fixed_price">12000.0</field>
            <field name="currency_id" ref="base.ARS"/>
        </record>

