<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_close_reason_form" model="ir.ui.view">
        <field name="name">sale.order.close.reason.form.inherit</field>
        <field name="model">sale.order.close.reason</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_close_reason_view_form"/>
        <field name="arch" type="xml">
            <field name="visible_in_portal" position="after">
                <field name="release_vacancy"/>
                <field name="no_reopen_subscription"/>
            </field>
        </field>
    </record>
    <record id="view_sale_order_close_reason_list" model="ir.ui.view">
        <field name="name">sale.order.close.reason.list.inherit</field>
        <field name="model">sale.order.close.reason</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_close_reason_view_tree"/>
        <field name="arch" type="xml">
            <field name="visible_in_portal" position="after">
                <field name="release_vacancy"/>
                <field name="no_reopen_subscription"/>
            </field>
        </field>
    </record>
</odoo>
