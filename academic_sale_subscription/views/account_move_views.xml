<odoo>
    <record id="academic_view_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="before">
                <field name="student_id" optional="show"/>
            </field>
            <list position="inside">
                <header>
                    <button name="%(academic_sale_subscription.action_update_payment_responsible)d" string="Update Payment Responsible" type="action" class="oe_highlight"/>
                </header>
            </list>
        </field>
    </record>
    <record id="academic_view_move_form" model="ir.ui.view">
        <field name="name">academic.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <label for="partner_id" position="attributes">
                <attribute name="string">Payment responsible</attribute>
            </label>
            <field name="partner_shipping_id" position="before">
                <field name="student_ids" invisible="1"/>
                <field name="student_id" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="state != 'draft'" options="{'no_create': True}"/>
                <field name="family_id"/>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//sheet" position="before">
                <field name="require_student_on_invoices" invisible="1"/>
                <div class="alert alert-warning oe_edit_only" role="alert" invisible="student_id or not require_student_on_invoices or not is_academic_sale">
                  Warning: This invoice is not associated with any student
                </div>
            </xpath>
        </field>
    </record>
    <record id="academic_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">academic.account.move.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="student_id"/>
                <field name="family_id"/>
                <filter string="Not payment responsible" name="not_payment_responsible"
                    domain="['!', ('partner_id', 'any', [('partner_link_ids.role_ids', 'in', [%(academic.paying_role)d])])]"/>
            </field>
            <group>
                <filter string="Family" name="group_by_family" domain="[]" context="{'group_by': 'family_id'}"/>
            </group>
        </field>
    </record>
</odoo>
