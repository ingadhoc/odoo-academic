<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_order_view_form" model="ir.ui.view">
        <field name="name">sale.subscription.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='plan_block']//field[@name='end_date']" position="after">
                <div style="width:100%">
                    <field name="show_update_end_date" invisible="1"/>
                    <button name="set_deferred_end_date_from_button" type="object"
                        string="Update End Date"
                        help="Recompute end date based on this next invoice date"
                        class="btn-link" icon="fa-refresh"
                        invisible="not show_update_end_date"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="sale_subscription_template_view_search" model="ir.ui.view">
        <field name="name">sale.order.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_search"/>
        <field name="arch" type="xml">
            <filter name="recurring_next_date" position="after">
                <separator/>
                <filter string="Current Main Group" name="group_by_main_group" context="{'group_by':'current_main_group_id'}"/>
            </filter>
        </field>
    </record>

    <menuitem name="Duplicated Subscriptions" id="menu_duplicated_subscription" action="action_show_duplicated_subscription" parent="sale_subscription.menu_sale_subscription" sequence="90"/>
</odoo>
