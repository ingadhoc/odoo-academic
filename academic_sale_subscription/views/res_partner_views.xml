<odoo>
    <record id="view_academic_partner_tree" model="ir.ui.view">
        <field name="name">academic.sale.suscription.partner.list</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="academic.view_academic_partner_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button name="open_academic_order_wizard"
                            type="object"
                            string="Create Order"
                            class="btn-secondary"
                            groups="academic.group_user"/>
                </header>
            </list>
            <groupby name="current_main_group_id" position="inside">
                <button
                    type="object"
                    name="open_order_wizard"
                    icon="fa-shopping-cart"
                    title="Open order wizard"
                />
            </groupby>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">academic.sale.suscription.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Current Subscriptions" name="current_subscriptions">
                    <button name="%(academic_sale_subscription.action_view_academic_order_wizard)d"
                            type="action"
                            string="Create Order"
                            class="btn-secondary"
                            groups="academic.group_manager"/>
                    <field name="current_subscription_ids">
                        <list default_order="next_invoice_date, partner_invoice_id, payment_term_id">
                            <field name="order_id"/>
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                            <field name="subscription_plan_id"/>
                            <field name="next_invoice_date"/>
                            <field name="partner_invoice_id"/>
                            <field name="payment_term_id"/>
                            <button type="object" name="open_subscription_form" icon="fa-pencil-square-o" title="Open" help="Open Subscription"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <page name="accounting_disabled" position="attributes">
                <attribute name="invisible">is_company or not parent_id or partner_type in ['student', 'family']</attribute>
            </page>
            <!-- ventas y compras por ahora dejamos que respete comportamiento nativo de odoo, siempre visible. Sirve por ej. para setear comercial (Sea a nivel familia o por alumno) -->
            <!-- <page name="sales_purchases" position="attributes">
                <attribute name="invisible">partner_type in ['student', 'family']</attribute>
            </page> -->
            <page name="accounting" position="attributes">
                <attribute name="invisible">partner_type in ['student', 'family'] or not is_company and parent_id</attribute>
            </page>

        </field>
    </record>

    <record id="view_academic_partner_form" model="ir.ui.view">
        <field name="name">academic.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="academic.view_academic_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='student_link_ids']//list//field[@name='note']" position="after">
                <button name="action_change_payment_responsible"
                        type="object"
                        icon="fa-exchange"
                        title="Change Payment Responsible"
                        help="Payment responsible will be changed for active sales and pending debts"
                        class="btn-secondary btn-sm"/>
            </xpath>
        </field>
    </record>
</odoo>
