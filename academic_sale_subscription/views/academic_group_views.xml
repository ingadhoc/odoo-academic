<odoo>
    <record id="view_academic_group_form" model="ir.ui.view">
        <field name="name">academic.group.form</field>
        <field name="model">academic.group</field>
        <field name="inherit_id" ref="academic.view_academic_group_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="open_fee_sales" type="object" class="oe_stat_button" icon="fa-usd" invisible="not manage_sale_workflow">
                    <field string="Fee" name="fee_student_count" widget="statinfo"/>
                </button>
                <button name="open_no_fee_students" type="object" class="oe_stat_button" icon="fa-user-o" invisible="not manage_sale_workflow or no_fee_student_count &lt; 1" context='{"academic_group_id": id}'>
                    <field string="No Fee" name="no_fee_student_count" widget="statinfo"/>
                </button>
                <button name="open_registration_sales" type="object" class="oe_stat_button" icon="fa-plus" invisible="not manage_sale_workflow">
                    <field string="Registration" name="registration_student_count" widget="statinfo"/>
                </button>
                <button name="open_opportunities" type="object" class="oe_stat_button" icon="fa-star" help="Opportunities linked to this group" invisible="not manage_sale_workflow">
                    <field string="Opportunities" name="opportunities_student_count" widget="statinfo"/>
                </button>
            </div>
            <field name="subject_id" position="after">
                <field name="manage_sale_workflow" groups="base.group_no_one"/>
            </field>
            <field name="capacity" position="after">
                <field name="vacancies"/>
            </field>
            <field name="student_ids" position="attributes">
                <attribute name="readonly">manage_sale_workflow</attribute>
            </field>
        </field>
    </record>

    <record id="view_academic_group_tree" model="ir.ui.view">
        <field name="name">academic.group.list</field>
        <field name="model">academic.group</field>
        <field name="inherit_id" ref="academic.view_academic_group_tree"/>
        <field name="arch" type="xml">
            <list>
                <field name="vacancies"/>
            </list>
        </field>
    </record>

</odoo>
