<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_case_opportunities_filter" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.group_id</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="group_id"/>
            </field>
        </field>
    </record>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.group_id</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="group_id" options="{'no_create': True}"/>
                </group>
            </xpath>
            <xpath expr="//label[@for='expected_revenue']//.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button string="Create Academic Structure" type="object" name="action_create_family"
                    class="btn-primary" invisible="not family_member_ids"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Family Group" name="family">
                    <field name="family_member_ids">
                        <list editable="bottom">
                            <field name="member_type" readonly="partner_id"/>
                            <field name="name" readonly="partner_id"/>
                            <field name="vat" readonly="partner_id or member_type == 'family'"/>
                            <field name="email" readonly="partner_id or member_type == 'family'"/>
                            <field name="relationship_id" readonly="member_type in ('family', 'student') or partner_id"
                                required="member_type == 'parent'"/>
                            <field name="role_ids" widget="many2many_tags"
                                invisible="member_type == 'family'" readonly="partner_id"/>
                            <field name="partner_id" readonly="1" optional="show"/>
                            <button name="action_open_partner" type="object" icon="fa-external-link"
                                invisible="not partner_id" title="Open contact"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="quick_create_opportunity_form" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">Student's name</attribute>
                <attribute name="placeholder">Fill in the student's name</attribute>
            </field>
        </field>
    </record>

</odoo>
