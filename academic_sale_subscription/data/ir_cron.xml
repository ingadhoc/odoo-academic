<odoo noupdate="1">
    <record id="ir_cron_grouped_invoice_notice" model="ir.cron">
        <field name="name">Grouped Invoice Notice by Payment Responsible</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_grouped_invoice_notice()</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=11, minute=0, second=0)"/>
        <field name="interval_number" eval="1"/>
        <field name="interval_type">days</field>
    </record>
</odoo>
