<odoo>
    <record id="report_debt_free_certificate" model="ir.actions.report">
        <field name="name">Debt Free Certificate</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">academic_sale_subscription.report_debt_free_certificate_document</field>
        <field name="report_file">academic_sale_subscription.report_debt_free_certificate_document</field>
        <field name="print_report_name">'Debt Free Certificate - ' + object.name</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_generate_debt_free_certificate" model="ir.actions.server">
        <field name="name">Generate Debt Free Certificate</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_generate_debt_free_certificate()
        </field>
    </record>
</odoo>
