<odoo noupdate="1">
    <record id="ir_cron_update_current_main_group" model="ir.cron">
        <field name="name">Automatic update of current main group</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
model.search([('partner_type', '=', 'student')])._compute_current_main_group()
        </field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="numbercall" eval="-1"/>
        <field name="nextcall" eval="DateTime.now().replace(day=1, month=1, hour=22, minute=0)"/>
        <field name="interval_number" eval="12"/>
        <field name="interval_type">months</field>
    </record>
</odoo>
