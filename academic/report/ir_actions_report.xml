<odoo>
    <record id="report_certificate_regular_student" model="ir.actions.report">
        <field name="name">Certificate of Regular Student</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">academic.report_certificate_regular_student_document</field>
        <field name="report_file">academic.report_certificate_regular_student_document</field>
        <field name="print_report_name">'Certificate of Regular Student ' + object.name</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
    </record>

    <record id="report_basic_group_data" model="ir.actions.report">
        <field name="name">Print Basic Group Data</field>
        <field name="model">academic.group</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">academic.report_basic_group_data_document</field>
        <field name="report_file">academic.report_basic_group_data_document</field>
        <field name="print_report_name">'Basic Group Data - %s' % (object.name)</field>
        <field name="binding_model_id" ref="academic.model_academic_group"/>
    </record>
</odoo>
