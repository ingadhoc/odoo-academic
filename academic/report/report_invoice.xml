<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//div[hasclass('row')]" position="before">
                <div class="row">
                    <div class="col-6">
                        <t t-if="o.student_id">
                            <strong>Student Information:</strong>
                            <div>
                                <span t-field="o.student_id" t-options='{"widget": "contact"}'/>
                            </div>
                            <div>
                                <span t-field="o.student_id.dni"/>
                            </div>
                            <div>
                                <span t-field="o.student_id.current_main_group_id"/>
                            </div>
                        </t>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
