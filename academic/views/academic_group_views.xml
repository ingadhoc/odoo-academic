<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_academic_group_filter" model="ir.ui.view">
        <field name="name">academic.group.select</field>
        <field name="model">academic.group</field>
        <field name="arch" type="xml">
            <search string="group">
                <group string="By Attribute">
                    <field name="year" string="Year" />
                    <field name="division_id" string="Division" />
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group string="By object">
                    <field name="level_id" string="Level" />
                </group>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- FORMVIEW -->
    <record id="view_academic_group_form" model="ir.ui.view">
        <field name="name">academic.group.form</field>
        <field name="model">academic.group</field>
        <field name="arch" type="xml">
            <form string="group">
                <field name="study_plan_level_ids" invisible='1'/>
                <field name="company_id" invisible="1"/>
                <sheet string="group">
                     <div class="oe_button_box" name="button_box">
                        <button name="open_students" type="object" class="oe_stat_button" icon="fa-user" context="{'type': 'active'}">
                            <field string="Active" name="active_student_count" widget="statinfo"/>
                        </button>
                        <button name="open_enrolling_sales" type="object" class="oe_stat_button" icon="fa-user-o" context="{'type': 'enrolling'}">
                            <field string="Enrolling" name="enrolling_student_count" widget="statinfo"/>
                        </button>
                        <button name="open_leads" type="object" class="oe_stat_button" icon="fa-user-plus" context="{'type': 'prospect'}" help="Opportunities linked to this group">
                            <field string="Prospect" name="prospect_student_count" widget="statinfo"/>
                        </button>
                        <!-- <button name="open_links" type="object" class="oe_stat_button" icon="fa-user-plus">
                            <field string="Prospect" name="prospect_student_count" widget="statinfo"/>
                        </button> -->
                     </div>
                    <group>
                        <group>
                            <!-- Por ahora no usamos type, me parece que lo podemos borrar -->
                            <!-- <field name="type"/> -->
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="level_id" domain="[('id','in',study_plan_level_ids)]"/>
                            <field name="division_id" required="1"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="capacity"/>
                            <field name="vacancies"/>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- TREEVIEW -->

    <record id="view_academic_group_tree" model="ir.ui.view">
        <field name="name">academic.group.list</field>
        <field name="model">academic.group</field>
        <field name="arch" type="xml">
            <list string="group">
                <!-- <field name="type"/> -->
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="level_id"/>
                <field name="division_id"/>
                <!-- <field name="subject_id"/> -->
                <field name="year"/>
                <field name="capacity"/>
                <field name="vacancies"/>
            </list>
        </field>
    </record>

    <record id="view_academic_group_list_no_create" model="ir.ui.view">
        <field name="name">academic.group.tree.no_create</field>
        <field name="model">academic.group</field>
        <field name="arch" type="xml">
            <list string="group" create="0">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="level_id"/>
                <field name="division_id"/>
                <field name="year"/>
            </list>
        </field>
    </record>

     <record id="action_academic_group_groups" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">academic.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_academic_group_tree"/>
        <field name="search_view_id" ref="view_academic_group_filter"/>
        <field name="domain">[]</field>
    </record>

     <record id="action_academic_company_group_groups" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">academic.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_academic_group_tree"/>
        <field name="search_view_id" ref="view_academic_group_filter"/>
        <field name="domain">[('company_id','=',id)]</field>
    </record>

    <record id="move_to_next_year" model="ir.actions.server">
        <field name="name">Move to Next Year</field>
        <field name="state">code</field>
        <field name="model_id" ref="model_academic_group"/>
        <field name="binding_model_id" ref="model_academic_group"/>
        <field name="binding_type">action</field>
        <field name="code">
            if records:
                action = records.create_next_year_groups()
        </field>
    </record>

    <menuitem name="Groups" id="menu_groups" sequence="10" action="action_academic_group_groups" parent="menu_data" groups="group_user" />
    <!-- portal menu -->
    <menuitem name="Groups" id="menu_portal_groups" sequence="25" action="action_academic_group_groups" parent="menu_portal_academic" groups="group_portal_teacher" />

</odoo>
