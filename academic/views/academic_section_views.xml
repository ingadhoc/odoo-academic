<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_section_filter" model="ir.ui.view">
        <field name="name">academic.section.select</field>
        <field name="model">academic.section</field>
        <field name="arch" type="xml">
            <search>
                <group>
                    <field name="name" string="Name" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_academic_section_form" model="ir.ui.view">
        <field name="name">academic.section.form</field>
        <field name="model">academic.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <!-- <field name="correlative_ids" widget="many2many_tags" domain="[('id', '!=', id)]"/> -->
                        <field name="level_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academic_section_tree" model="ir.ui.view">
        <field name="name">academic.section.list</field>
        <field name="model">academic.section</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <!-- <field name="correlative_ids" widget="many2many_tags"/> -->
                <field name="level_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

     <record id="action_academic_section_sections" model="ir.actions.act_window">
        <field name="name">Study Plans</field>
        <field name="res_model">academic.section</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_academic_section_tree"/>
        <field name="search_view_id" ref="view_academic_section_filter"/>
        <field name="domain">[]</field>
    </record>

    <menuitem name="Study Plans" id="menu_sections" sequence="20" action="action_academic_section_sections" parent="menu_general_data" groups="group_manager" />

</odoo>
