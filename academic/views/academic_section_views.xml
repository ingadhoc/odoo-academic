<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_section_filter" model="ir.ui.view">
        <field name="name">academic.section.select</field>
        <field name="model">academic.section</field>
        <field name="arch" type="xml">
            <search>
                <group>
                    <field name="name" string="Name" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_academic_section_form" model="ir.ui.view">
        <field name="name">academic.section.form</field>
        <field name="model">academic.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <!-- <field name="correlative_ids" widget="many2many_tags" domain="[('id', '!=', id)]"/> -->
                    </group>
                    <notebook>
                        <page string="Levels" name="levels">
                            <div class="text-muted mb-2">
                                Drag the levels into the order the student goes through them: the
                                re-enrollment wizard uses it to suggest the next level of each group.
                            </div>
                            <field name="level_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="level_id" options="{'no_quick_create': 1}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academic_section_tree" model="ir.ui.view">
        <field name="name">academic.section.list</field>
        <field name="model">academic.section</field>
        <field name="arch" type="xml">
            <!-- open_form_view: the list is editable, so without it the form where the levels are ordered is unreachable -->
            <list editable="bottom" open_form_view="True">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <!-- <field name="correlative_ids" widget="many2many_tags"/> -->
                <!-- readonly: the ordered lines on the form are the only write path, so adding a
                     level from here cannot silently append it at the end of the plan -->
                <field name="level_ids" widget="many2many_tags" optional="show" readonly="1"/>
            </list>
        </field>
    </record>

     <record id="action_academic_section_sections" model="ir.actions.act_window">
        <field name="name">Study Plans</field>
        <field name="res_model">academic.section</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_academic_section_tree"/>
        <field name="search_view_id" ref="view_academic_section_filter"/>
        <field name="domain">[]</field>
    </record>

    <menuitem name="Study Plans" id="menu_sections" sequence="20" action="action_academic_section_sections" parent="menu_general_data" groups="group_manager" />

</odoo>
