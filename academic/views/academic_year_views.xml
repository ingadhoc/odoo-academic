<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_year_filter" model="ir.ui.view">
        <field name="name">academic.year.search</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_academic_year_form" model="ir.ui.view">
        <field name="name">academic.year.form</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="main">
                            <field name="name"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="groups" string="Groups">
                            <field name="group_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academic_year_tree" model="ir.ui.view">
        <field name="name">academic.year.list</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="action_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Academic Year
            </p>
        </field>
    </record>

    <menuitem action="action_academic_year"
              id="menu_years"
              name="Academic Years"
              parent="menu_general_data"
              sequence="30"/>

</odoo>
