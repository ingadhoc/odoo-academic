<odoo>
    <record id="academic_group_move_student_wizard_form" model="ir.ui.view">
        <field name="name">academic.group.move.student.wizard.form</field>
        <field name="model">academic.group.move.student.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="parent_group_id" invisible="1"/>
                    <field name="student_to_move" invisible="1"/>
                    <field name="child_group_id" options="{'no_create': 1}" required="1"/>
                    <field name="student_ids"/>
                </group>
                <footer>
                    <button string="Move Students" type="object" name="move_students" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_academic_group_move_student_wizard" model="ir.actions.act_window">
        <field name="name">Move Students</field>
        <field name="res_model">academic.group.move.student.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
