<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="academic_contact_import_view_form" model="ir.ui.view">
        <field name="name">academic.contact.import.form</field>
        <field name="model">academic.contact.import</field>
        <field name="arch" type="xml">
            <form string="Import Academic Contacts">
                <div class="alert alert-info" role="status" invisible="state == 'done'">
                    <p>
                        Upload a spreadsheet (.xlsx) with one row per <b>student + relative</b>.
                        Expected columns, in order:
                        <i>Surname · Student name · Student DNI · Tags ·
                        Relative · Relationship · Roles · Relative DNI ·
                        AFIP responsibility type · Email · Phone</i>.
                        The <b>Relationship</b> column must be exactly one of:
                        <i>Padre/Madre · Pariente · Abuelo/a · Otro</i>.
                        The <b>Roles</b> and <b>Tags</b> columns list one or more existing names
                        separated by commas (e.g. <i>Responsable de Facturación, Puede Retirar</i>);
                        they must already exist or the import fails. The paying role is only assigned
                        to relatives that have a DNI.
                        The <b>AFIP responsibility type</b> column is optional and only used when the
                        Argentinian localization is installed.
                        Families and relatives are deduplicated automatically (by relative DNI),
                        so re-uploading does not create duplicates.
                    </p>
                    <a href="/academic/static/src/xls/contactos_academicos_ejemplo.xlsx"
                        download="contactos_academicos_ejemplo.xlsx"
                        class="btn btn-link ps-0" role="button">
                        <i class="fa fa-download"/> Download example file
                    </a>
                </div>
                <group invisible="state == 'done'">
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <field name="state" invisible="1"/>
                <field name="result_html" invisible="state != 'done'" readonly="1"/>
                <footer>
                    <button string="Import" name="action_import" type="object"
                        class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="academic_contact_import_action" model="ir.actions.act_window">
        <field name="name">Import Academic Contacts</field>
        <field name="res_model">academic.contact.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem name="Import Contacts" id="menu_academic_contact_import"
        parent="menu_configuration" sequence="90" groups="group_manager"
        action="academic_contact_import_action"/>
</odoo>
