<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">



    <!-- Colegio Los Arroyos -->
    <record id="res_company_los_arroyos" model="res.company">
        <field name="name">Colegio Los Arroyos - Sede San Isidro</field>
        <field name="partner_id" ref="res_partner_los_arroyos"/>
        <field name="currency_id" ref="base.USD"/>
        <field name="section_ids" eval="[(4, ref('academic_section_1')), (4, ref('academic_section_2')), (4, ref('academic_section_3'))]"/>
        <field name="country_id" ref="base.us"/>
        <field name="state_id" ref="state_demo_us_ca"/>
        <field name="family_required" eval="False"/>
    </record>

    <!-- Colegio Los Molinos -->
    <record id="res_company_los_molinos" model="res.company">
        <field name="name">Colegio Los Molinos</field>
        <field name="partner_id" ref="res_partner_los_molinos"/>
        <field name="currency_id" ref="base.USD"/>
        <field name="section_ids" eval="[(4, ref('academic_section_1')), (4, ref('academic_section_2'))]"/>
        <field name="country_id" ref="base.us"/>
        <field name="state_id" ref="state_demo_us_ca"/>
        <field name="family_required" eval="False"/>
    </record>

    <!-- Jardín Los Senderos -->
    <record id="res_company_los_senderos" model="res.company">
        <field name="name">Jardín Los Senderos</field>
        <field name="partner_id" ref="res_partner_los_senderos"/>
        <field name="currency_id" ref="base.USD"/>
        <field name="section_ids" eval="[(4, ref('academic_section_1'))]"/>
        <field name="country_id" ref="base.us"/>
        <field name="state_id" ref="state_demo_us_ca"/>
        <field name="family_required" eval="True"/>
    </record>

    <!-- Facultad de Ingeniería -->
    <record id="res_company_facultad_ingenieria" model="res.company">
        <field name="name">Facultad de Ingeniería</field>
        <field name="partner_id" ref="res_partner_facultad_ingenieria"/>
        <field name="currency_id" ref="base.ARS"/>
        <field name="section_ids" eval="[(4, ref('academic_section_9')), (4, ref('academic_section_10'))]"/>
        <field name="country_id" ref="base.ar"/>
        <field name="state_id" ref="state_demo_ar_ba"/>
        <field name="family_required" eval="False"/>
    </record>

</odoo>
