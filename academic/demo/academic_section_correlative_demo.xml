    </record>
    <record id="academic_section_3" model="academic.section">
        <field name="correlative_ids" eval="[Command.set([ref('academic_section_4')])]"/>
    </record>
    <record id="academic_section_6" model="academic.section">
        <field name="correlative_ids" eval="[Command.set([ref('academic_section_7')])]"/>
    </record>
    <record id="academic_section_7" model="academic.section">
        <field name="correlative_ids" eval="[Command.set([ref('academic_section_8')])]"/>
    </record>
    <record id="academic_section_9" model="academic.section">
        <field name="correlative_ids" eval="[Command.set([ref('academic_section_10')])]"/>
    </record>
</odoo>
