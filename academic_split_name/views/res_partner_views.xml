<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="academic.view_academic_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//h1" position="attributes">
                <attribute name="invisible">partner_type in ['student', 'parent', 'family']</attribute>
            </xpath>
            <xpath expr="//h1" position="after">
                <div class="d-flex flex-wrap gap-2 w-md-75" invisible="partner_type not in ['student', 'parent', 'family']">
                    <div class="flex-grow-1" style="min-width: 200px;">
                        <label for="lastname" class="d-block"/>
                        <field
                            name="lastname"
                            string="Last Name"
                            required="partner_type in ['student', 'parent', 'family']"
                            placeholder="Last Name"
                            class="w-100"/>
                    </div>
                    <div class="flex-grow-1" style="min-width: 200px;">
                        <label for="second_lastname" class="d-block"/>
                        <field
                            name="second_lastname"
                            string="Second Last Name"
                            placeholder="Second Last Name"
                            class="w-100"/>
                    </div>
                    <div class="flex-grow-1" style="min-width: 200px;" invisible="partner_type not in ['student', 'parent']">
                        <label for="firstname" class="d-block"/>
                        <field
                            name="firstname"
                            string="First Name"
                            required="partner_type in ['student', 'parent']"
                            placeholder="First Name"
                            class="w-100"/>
                    </div>
                    <div class="flex-grow-1" style="min-width: 200px;" invisible="partner_type not in ['student', 'parent']">
                        <label for="middlename" class="d-block"/>
                        <field
                            name="middlename"
                            string="Middle Name"
                            placeholder="Middle Name"
                            class="w-100"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='student_link_ids']/list//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
                <attribute name="context">{'default_partner_type': 'parent'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
