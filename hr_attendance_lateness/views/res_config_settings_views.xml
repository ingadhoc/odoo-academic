<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_lateness" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.lateness</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='overtime_settings']" position="after">
                <block title="Lateness Control" name="lateness_settings">
                    <setting
                        string="Attendance Lateness Threshold"
                        company_dependent="1"
                        help="Set the tolerance time in minutes before marking an employee as late. Set to 0 for no tolerance (any delay is considered late)."
                    >
                        <field
                            name="attendance_lateness_threshold"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
