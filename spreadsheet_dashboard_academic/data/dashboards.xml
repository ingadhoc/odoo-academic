<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="spreadsheet_dashboard_group_academic" model="spreadsheet.dashboard.group">
        <field name="name">Academic</field>
        <field name="sequence">300</field>
    </record>

    <record id="dashboard_billing_tracking" model="spreadsheet.dashboard">
        <field name="name">Seguimiento de Facturación</field>
        <field name="spreadsheet_binary_data" type="base64" file="spreadsheet_dashboard_academic/data/files/billing_tracking_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_academic.spreadsheet_dashboard_group_academic"/>
        <field name="group_ids" eval="[Command.link(ref('academic.group_manager'))]"/>
        <field name="sequence">10</field>
    </record>

</odoo>
