<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_academic" model="ir.ui.view">
        <field name="name">hr.employee.form.academic</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="before">
                <widget name="web_ribbon" title="Child" bg_color="bg-warning" invisible="not main_employee_id"/>
            </div>

            <xpath expr="//field[@name='work_email']//.." position="before">
                <h5 class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-user fa-fw me-1 text-primary" title="Main Employee"/>
                    <field name="main_employee_id" placeholder="Main Employee" class="w-100 w-sm-75"/>
                </h5>
            </xpath>

            <group name="user" position="attributes">
                <attribute name="invisible">main_employee_id</attribute>
            </group>

            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="readonly">main_employee_id</attribute>
            </xpath>

            <page name="work_information" position="before">
                <page string="Child Employees" name="child_employees" invisible="main_employee_id">
                    <field name="child_employee_ids" mode="kanban" context="{'default_main_employee_id': id, 'default_company_id': company_id, 'default_user_id': user_id}">
                        <kanban>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <templates>
                                <t t-name="card" class="flex-row">
                                    <aside class="o_kanban_aside_full">
                                        <field name="image_128" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Employee"/>
                                    </aside>
                                    <main class="ps-2 ps-md-0">
                                        <field name="name" class="fw-bold"/>
                                        <div t-if="record.job_id.raw_value">
                                            <i class="fa fa-briefcase" role="img" aria-label="Job" title="Job"></i>
                                            <field name="job_id"/>
                                        </div>
                                        <div t-if="record.department_id.raw_value">
                                            <i class="fa fa-building" role="img" aria-label="Department" title="Department"></i>
                                            <field name="department_id"/>
                                        </div>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="view_employee_filter_academic" model="ir.ui.view">
        <field name="name">hr.employee.search.academic</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <filter name="my_team" position="before">
                <filter name="main_employees" string="Main Employees"
                        domain="[('main_employee_id', '=', False)]"/>
                <filter name="child_employees" string="Child Employees"
                        domain="[('main_employee_id', '!=', False)]"/>
                <separator/>
            </filter>
        </field>
    </record>

    <record id="hr.open_view_employee_list_my" model="ir.actions.act_window">
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'search_default_main_employees': 1}</field>
    </record>
</odoo>
