    <record id="academic.res_partner_flia_fernandez" model="res.partner">
        <field name="category_id" eval="[(4, ref('partner_category_scholarship'))]"/>
        <field name="property_product_pricelist" ref="product_pricelist_becados"/>
    </record>

    <record id="academic.res_partner_flia_rodriguez" model="res.partner">
        <field name="category_id" eval="[(4, ref('partner_category_vip'))]"/>
